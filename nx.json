{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "namedInputs": {
    "sharedGlobals": [
      "{workspaceRoot}/deno.json",
      "{workspaceRoot}/deno.lock",
      "{workspaceRoot}/pnpm-workspace.yaml",
      "{workspaceRoot}/.github/workflows/*.yml"
    ],
    "default": [
      "{projectRoot}/**/*",
      "!{projectRoot}/dist/**",
      "!{projectRoot}/boards/**",
      "sharedGlobals"
    ],
    "production": [
      "default",
      "!{projectRoot}/**/*.test.ts",
      "!{projectRoot}/**/*.test.tsx",
      "!{projectRoot}/**/*.md"
    ]
  },
  "targetDefaults": {
    "build": {
      "cache": true,
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "production",
        "^production"
      ],
      "outputs": [
        "{projectRoot}/dist"
      ]
    },
    "check": {
      "cache": true,
      "inputs": [
        "default",
        "^production"
      ]
    },
    "lint": {
      "cache": true,
      "inputs": [
        "default"
      ]
    },
    "fmt": {
      "cache": true,
      "inputs": [
        "default"
      ]
    },
    "test": {
      "cache": true,
      "inputs": [
        "default",
        "^production"
      ]
    },
    "smoke": {
      "cache": true,
      "dependsOn": [
        "build"
      ],
      "inputs": [
        "production",
        "^production"
      ]
    },
    "pack-check": {
      "cache": true,
      "dependsOn": [
        "build"
      ],
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/pnpm-lock.yaml"
      ]
    },
    "verify": {
      "dependsOn": [
        "check",
        "lint",
        "fmt",
        "test"
      ]
    }
  },
  "analytics": false
}
