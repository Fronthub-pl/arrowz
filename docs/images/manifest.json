  "handMade": [
    {
      "out": "rule-free",
      "why": "A hand-drawn composite: a grid of <line> elements the CLI never emits, a dashed lane, and a piece group in the CLI's style pasted in. No invocation reproduces it."
    },
    {
      "out": "rule-blocked",
      "why": "Hand-drawn like rule-free, with a second piece parked across the lane."
    },
    {
      "out": "rule-shape",
