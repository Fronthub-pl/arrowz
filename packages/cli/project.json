{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "cli",
  "projectType": "application",
  "sourceRoot": "packages/cli",
  "implicitDependencies": ["engine"],
  "targets": {
    "check": { "executor": "nx:run-commands", "options": { "cwd": "packages/cli", "command": "deno check *.ts" } },
    "lint": { "executor": "nx:run-commands", "options": { "cwd": "packages/cli", "command": "deno lint" } },
    "fmt": { "executor": "nx:run-commands", "options": { "cwd": "packages/cli", "command": "deno fmt --check" } },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/cli",
        "command": "deno test --allow-read --allow-write --allow-env --allow-run --allow-net"
      }
    },
    "store": {
      "executor": "nx:run-commands",
      "continuous": true,
      "cache": false,
      "options": { "cwd": "packages/cli", "command": "deno task store" }
    },
    "build": { "executor": "nx:run-commands", "options": { "cwd": "packages/cli", "command": "pnpm run build" } },
    "smoke": { "executor": "nx:run-commands", "options": { "cwd": "packages/cli", "command": "pnpm run smoke" } },
    "pack-check": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/cli",
        "command": "deno run --allow-read --allow-write --allow-run --allow-env ../engine/scripts/pack-check.ts ."
      }
    },
    "verify": { "executor": "nx:noop", "dependsOn": ["check", "lint", "fmt", "test", "smoke"] }
  }
}
