{
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true
  },
  "tasks": {
    "carve": "deno run --allow-read --allow-write --allow-env carve.ts",
    "bundle": "deno bundle --platform browser --outdir dist --sourcemap linked lab-page.ts lab-worker.ts",
    "lab": "sh lab.sh",
    "compile": "deno compile --allow-read --allow-write --allow-env -o dist/carve carve.ts"
  }
}
