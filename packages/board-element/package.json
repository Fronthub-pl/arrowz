{
  "name": "@fronthub/arrowz-board",
  "version": "0.1.0",
  "description": "<arrowz-board>: a web component that draws an Arrowz board on the GPU and plays it.",
  "keywords": [
    "arrowz",
    "puzzle",
    "board",
    "web-component",
    "custom-element",
    "lit",
    "webgl"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fronthub-pl/arrowz.git",
    "directory": "packages/board-element"
  },
  "homepage": "https://github.com/Fronthub-pl/arrowz/tree/main/packages/board-element#readme",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "exports": {
    ".": {
      "types": "./dist/mod.d.ts",
      "default": "./dist/mod.js"
    }
  },
  "sideEffects": [
    "./dist/arrowz-board.js",
    "./dist/mod.js"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "check": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "serve": "vite"
  },
  "dependencies": {
    "@fronthub/arrowz-engine": "workspace:^",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@vitest/browser-playwright": "^5.0.0",
    "playwright": "^1.63.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
