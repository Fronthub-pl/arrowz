{
    "hooks": {
        "SessionStart": [
            {
                "matcher": "",
                "hooks": [
                    {
                        "type": "command",
                        "command": "jbcontext index --silent --only-incremental",
                        "async": true
                    }
                ]
            },
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "f=\"$CLAUDE_PROJECT_DIR/packages/cli/scripts/memory-guard.ts\"; [ -f \"$f\" ] || exit 0; deno run --quiet --allow-read=\"$HOME/.claude/projects\" --allow-run=gh,git --allow-env=HOME \"$f\" hook",
                        "timeout": 10
                    }
                ]
            }
        ],
        "SessionEnd": [
            {
                "matcher": "",
                "hooks": [
                    {
                        "type": "command",
                        "command": "jbcontext index --silent --only-incremental",
                        "async": true
                    }
                ]
            }
        ],
        "PreToolUse": [
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "if": "Bash(git commit *)",
                        "command": "f=\"$CLAUDE_PROJECT_DIR/packages/cli/scripts/jev-guard.ts\"; [ -f \"$f\" ] || exit 0; deno run --quiet --allow-net=api.typesafe.ai --allow-read=\"$CLAUDE_PROJECT_DIR\",\"$HOME/.config/arrowz\",/tmp,/private/tmp --allow-env=HOME,ARROWZ_TYPESAFE_ENV \"$f\" hook",
                        "timeout": 10
                    },
                    {
                        "type": "command",
                        "if": "Bash(gh pr *)",
                        "command": "f=\"$CLAUDE_PROJECT_DIR/packages/cli/scripts/jev-guard.ts\"; [ -f \"$f\" ] || exit 0; deno run --quiet --allow-net=api.typesafe.ai --allow-read=\"$CLAUDE_PROJECT_DIR\",\"$HOME/.config/arrowz\",/tmp,/private/tmp --allow-env=HOME,ARROWZ_TYPESAFE_ENV \"$f\" hook",
                        "timeout": 10
                    },
                    {
                        "type": "command",
                        "command": "f=\"$CLAUDE_PROJECT_DIR/packages/cli/scripts/bead-guard.ts\"; [ -f \"$f\" ] || exit 0; deno run --quiet --allow-run=bd,git --allow-read=\"$CLAUDE_PROJECT_DIR\",/tmp,/private/tmp \"$f\"",
                        "timeout": 15
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "f=\"$CLAUDE_PROJECT_DIR/packages/cli/scripts/bead-guard.ts\"; [ -f \"$f\" ] || exit 0; deno run --quiet --allow-run=bd,git --allow-read=\"$CLAUDE_PROJECT_DIR\",/tmp,/private/tmp \"$f\"",
                        "timeout": 15
                    }
                ]
            },
            {
                "matcher": "Edit|Write",
                "hooks": [
                    {
                        "type": "command",
                        "command": "f=\"$CLAUDE_PROJECT_DIR/packages/cli/scripts/jev-guard.ts\"; [ -f \"$f\" ] || exit 0; deno run --quiet --allow-net=api.typesafe.ai --allow-read=\"$CLAUDE_PROJECT_DIR\",\"$HOME/.config/arrowz\",/tmp,/private/tmp --allow-env=HOME,ARROWZ_TYPESAFE_ENV \"$f\" hook",
                        "timeout": 10
                    }
                ]
            },
            {
                "matcher": "Edit|Write|mcp__memory-arrowz__write_note|mcp__memory-arrowz__edit_note",
                "hooks": [
                    {
                        "type": "command",
                        "command": "f=\"$CLAUDE_PROJECT_DIR/packages/cli/scripts/memory-guard.ts\"; [ -f \"$f\" ] || exit 0; deno run --quiet --allow-net=api.typesafe.ai --allow-read=\"$HOME/.config/arrowz\" --allow-env=HOME,ARROWZ_TYPESAFE_ENV \"$f\" hook",
                        "timeout": 10
                    }
                ]
            }
        ]
    }
}
