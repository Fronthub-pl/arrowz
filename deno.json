{
  "workspace": ["./packages/engine", "./packages/cli", "./packages/board-element"],
  "nodeModulesDir": "manual",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1",
    "@std/path": "jsr:@std/path@^1"
  },
  "fmt": {
    "semiColons": false,
    "singleQuote": true,
    "lineWidth": 120,
    "exclude": [
      "**/*.md",
      "packages/cli/lab.html",
      "packages/board-element/demo/index.html",
      "packages/cli/boards/",
      "**/dist/",
      "docs/",
      "apps/",
      "node_modules/",
      "**/node_modules/",
      ".nx/",
      "pnpm-lock.yaml"
    ]
  },
  "lint": {
    "rules": { "tags": ["recommended"], "include": ["no-explicit-any", "no-non-null-assertion"] }
  },
  "test": {
    "exclude": ["packages/board-element/"]
  },
  "exclude": [
    "docs/",
    "apps/",
    "node_modules/",
    "**/node_modules/",
    ".nx/",
    "**/dist/",
    "packages/cli/boards/",
    ".claude/",
    ".mcp.json"
  ],
  "tasks": {
    "test": "deno test --allow-read --allow-write --allow-env --allow-run --allow-net packages/",
    "check": "deno check packages/engine/*.ts packages/engine/scripts/*.ts packages/cli/*.ts packages/cli/scripts/*.ts",
    "lint": "deno lint",
    "fmt": "deno fmt --check",
    "verify": "deno task check && deno task lint && deno task fmt && deno task test",
    "carve": "deno task --cwd=packages/cli carve",
    "report": "deno task --cwd=packages/cli report",
    "docs": "deno run --allow-read --allow-write --allow-run --allow-env packages/cli/scripts/record-doc-images.ts",
    "lab": "deno task --cwd=packages/cli lab",
    "bundle": "deno task --cwd=packages/cli bundle",
    "compile": "deno task --cwd=packages/cli compile"
  }
}
